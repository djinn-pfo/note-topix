# Raindrop.io personal API test token.
# Create at https://app.raindrop.io/settings/integrations -> "For Developers"
# -> Create new app -> open the app -> "Create test token".
TEST_TOKEN=

# Raindrop.io collection ID that holds the bookmarks to ingest.
# Open the collection on the web app; the ID is the number in the URL.
RAINDROP_COLLECTION_ID=

# Your note.com account name (the part after note.com/).
# Used by scripts/articles.py to pull your published articles, and by
# scripts/publish_annex.py for the annex site footer.
NOTE_USER=

# Model passed to `claude -p` for every LLM step. A full model ID is used
# because under cron the CLI's own default resolved to a retired model.
# NOTE_TOPIX_CLAUDE_MODEL=claude-opus-5
